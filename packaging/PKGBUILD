# Maintainer: bhimio1
pkgname=material-3-sound-git
pkgver=0.1.0
pkgrel=1
pkgdesc="Material 3 patchbay and mixer for PipeWire: draw cords between apps, effects and devices"
arch=('x86_64' 'aarch64')
url="https://github.com/bhimio1/material-3-sound"
license=('MIT')
depends=('libxkbcommon' 'wayland' 'libglvnd' 'fontconfig' 'pipewire' 'pipewire-audio' 'wireplumber')
makedepends=('cargo' 'git')
provides=('material-3-sound')
conflicts=('material-3-sound' 'material-3-sound-bin')
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  printf "0.1.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/m3-sound "$pkgdir/usr/bin/m3-sound"
  install -Dm644 packaging/material_3_sound.desktop "$pkgdir/usr/share/applications/material_3_sound.desktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 assets/fonts/LICENSE-Inter.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE-Inter.txt"
}
